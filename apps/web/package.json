{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @ai-template/content run build && concurrently -k -n content,next \"pnpm --filter @ai-template/content exec velite dev\" \"next dev\"",
    "build": "pnpm --filter @ai-template/content run build && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "pnpm --filter @ai-template/content run build && tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-template/config": "workspace:*",
    "@ai-template/content": "workspace:*",
    "@ai-template/ui": "workspace:*",
    "@ai-template/validation": "workspace:*",
    "@mdx-js/mdx": "^3.1.1",
    "flexsearch": "^0.8.212",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "next": "16.2.11",
    "next-themes": "^0.4.4",
    "nuqs": "^2.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.0.5"
  }
}
